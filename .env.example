# ---- App ----
# Public URL of the deployed app (used for OAuth redirects and webhook URLs shown to users)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32-byte key, base64. Encrypts each user's connection credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by webhooks, which arrive without a user session.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI (Claude API) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Google (Gmail + Calendar OAuth) ----
# Google Cloud console > APIs & Services > Credentials > OAuth client (Web).
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
